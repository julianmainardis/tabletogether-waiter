{
  "cli": {
    "version": ">= 5.9.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "distribution": "store"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://gastron-flow-backend.vercel.app/api",
        "EXPO_PUBLIC_FRONTEND_URL": "https://grupo-gastron-flow.vercel.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
