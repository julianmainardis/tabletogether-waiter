{
  "cli": {
    "version": ">= 5.9.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "simulator": {
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://table-together-backend-production.up.railway.app/api",
        "EXPO_PUBLIC_FRONTEND_URL": "https://table-together-client-production.up.railway.app/"
      }
    },
    "device-testing": {
      "ios": {
        "simulator": false,
        "distribution": "internal",
        "buildConfiguration": "Debug"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://table-together-backend-production.up.railway.app/api",
        "EXPO_PUBLIC_FRONTEND_URL": "https://table-together-client-production.up.railway.app/"
      }
    },
    "development-ios": {
      "ios": {
        "simulator": false,
        "distribution": "internal"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://table-together-backend-production.up.railway.app/api",
        "EXPO_PUBLIC_FRONTEND_URL": "https://table-together-client-production.up.railway.app/"
      }
    },
    "production": {
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "distribution": "store"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://table-together-backend-production.up.railway.app/api",
        "EXPO_PUBLIC_FRONTEND_URL": "https://table-together-client-production.up.railway.app/"
      }
    },
    "testing-ios": {
      "ios": {
        "distribution": "internal",
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://table-together-backend-production.up.railway.app/api",
        "EXPO_PUBLIC_FRONTEND_URL": "https://table-together-client-production.up.railway.app/"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
