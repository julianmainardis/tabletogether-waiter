{
  "expo": {
    "name": "Mobile Waiter",
    "slug": "mobile-waiter",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "mobile-waiter",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gastronflow.mobilewaiter",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.gastronflow.mobilewaiter",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "apiUrl": "https://gastron-flow-backend.vercel.app/api",
      "frontendUrl": "https://grupo-gastron-flow.vercel.app",
      "eas": {
        "projectId": "1edfa3ff-5b7e-410f-be06-b590e00b50fa"
      }
    },
    "owner": "julianmainardis",
    "eas": {
      "projectId": "1edfa3ff-5b7e-410f-be06-b590e00b50fa"
    }
  }
